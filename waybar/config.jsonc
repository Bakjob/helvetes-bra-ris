{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 1,
    "margin-left": 2,
    "margin-right": 2,

    "modules-left": [
        "hyprland/workspaces",
        "mpris",
        "custom/cava"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/dotfiles",
        "cpu",
        "custom/gpu",
        "pulseaudio",
        "battery",
        "custom/systemstats"
    ],

    "hyprland/workspaces": {
        "tooltip": true,
        "format": "{icon}",
        "format-icons": {
            "default": "●",
            "active": "●",
            "empty": "●"
        },
        "persistent-workspaces": {
            "*": 3
        }
    },

    "mpris": {
        "format": "{player_icon} {dynamic}",
        "format-paused": "{status_icon} {dynamic}",
        "player-icons": {
            "default": "♪"
        },
        "status-icons": {
            "paused": "⏸"
        },
        "tooltip-format": "{player} — {dynamic}",
        "max-length": 30
    },

    "custom/dotfiles": {
        "format": "⚙",
        "tooltip": true,
        "tooltip-format": "Öppna dotfiles",
        "on-click": "code --new-window ~/dotfiles"
    },

    "clock": {
        "format": "{:%H:%M}",
        "tooltip": true,
        "tooltip-format": "{:%A %d %B %Y}\n\n{calendar}"
    },

    "cpu": {
        "format": "󰘚 {usage}%",
        "interval": 6,
        "tooltip": true,
        "tooltip-format": "CPU-användning: {usage}%\nFrekvens: {avg_frequency} GHz\n\nKlicka för detaljerad vy",
        "on-click": "kitty --class btop-float -e btop"
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu.sh",
        "return-type": "json",
        "interval": 15,
        "format": "󰢮 {}",
        "on-click": "kitty --class btop-float -e intel_gpu_top"
    },

    "custom/systemstats": {
        "exec": "~/.config/waybar/scripts/systemstats-tooltip.sh",
        "return-type": "json",
        "interval": 6,
        "on-click": "eww open system-menu --toggle"
    },

    "custom/cava": {
        "exec": "~/.config/waybar/scripts/cava-waybar.sh",
        "return-type": "json",
        "tooltip": false
    },

    "pulseaudio": {
        "format": "󰕾 {volume}%",
        "format-muted": "󰝟 Tyst",
        "tooltip": true,
        "tooltip-format": "{desc}\nVolym: {volume}%",
        "on-click": "eww open volume-menu --toggle",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    "battery": {
        "format": "{icon} {capacity}%",
        "format-icons": ["󰁻", "󰁽", "󰁿", "󰂁", "󰁹"],
        "format-charging": "󰂄 {capacity}%",
        "format-full": "󰁹 Fulladdad",
        "tooltip": true,
        "tooltip-format": "Återstår: {time}\nKapacitet: {capacity}%",
        "states": {
            "warning": 25,
            "critical": 10
        },
        "on-click": "eww open battery-menu --toggle"
    }
}
