@import "colors.rasi"

configuration {
    modi: "drun";

    show-icons: true;

    icon-theme: "Qogir-Dark";

    drun-display-format: "{name}";

    font: "IBM Plex Mono 14";

    matching: "fuzzy";

    sort: true;

    sorting-method: "fzf";

    /* Musklick: rofis standard är klick = markera, dubbelklick = starta.
       Här startar ett vanligt klick appen direkt, och hover markerar. */
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
}

* {
    font: "IBM Plex Mono 14";

    background-color: @transparent;

    text-color: @fg;

    border-color: @border;
}

window {
    location: center;
    anchor: center;

    width: 82%;
    height: 82%;

    background-color: @bg;

    border: 0px;

    border-radius: 22px;
}

mainbox {
    children: [
        inputbar,
        listview
    ];

    spacing: 10px;

    padding: 20px;
}

inputbar {
    children: [
        entry
    ];

    background-color: transparent;

    padding: 10px 14px;
}

entry {
    text-color: @fg;

    placeholder: "Sök...";

    placeholder-color: @fg-muted;

    font: "IBM Plex Mono 22";
}

/* Grid-läge: flera kolumner, ikon ovanför text. Live-filtrering medan man
   skriver är rofis standardbeteende oavsett läge — kräver ingen extra config. */
listview {
    columns: 7;

    lines: 4;

    spacing: 14px;

    scrollbar: false;

    padding: 8px;

    dynamic: true;

    background-color: transparent;
}

element {
    orientation: vertical;

    padding: 14px 8px;

    border-radius: 14px;
}

element-icon {
    size: 64px;

    horizontal-align: 0.5;

    margin: 0px 0px 8px 0px;
}

element-text {
    text-color: @fg;

    horizontal-align: 0.5;

    vertical-align: 0.5;

    font: "IBM Plex Mono 11";
}

element normal.normal {
    background-color: @bg-solid;
    text-color: @fg;
}

element alternate.normal {
    background-color: @bg-solid;
    text-color: @fg;
}

element selected.normal {
    background-color: @selected-bg-solid;
    text-color: @gold;
    border: 1px solid;
    border-color: @selected-border;
}
