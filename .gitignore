# VS Code kan återskapa en tom workspace-fil av sig själv (se
# vault/02-beslut/changelog.md, 2026-09-14) — ingen sådan fil används längre,
# ⚙-knappen i waybar öppnar mappen direkt istället.
*.code-workspace

# Editor-/OS-skräp som inte hör hemma i rice-configen
.vscode/
*.swp
*.swo
*~
.DS_Store

# Dynamiskt wallust-tema (se vault/04-tema/dynamiskt-tema.md): dessa sex
# filer skrivs om av wallpaper-cycle.sh vid varje bakgrundsbyte (antingen av
# wallust eller kopierat från wallust/anchor/) - wallust/anchor/* och
# wallust/templates/* är den faktiska källan till sanning i git, inte dessa.
/waybar/colors.css
/kitty/colors.conf
/swaync/colors.css
/hypr/colors.lua
/rofi/colors.rasi
/eww/colors.scss

# Symlink som pekar på vilken bakgrundsbild som visas just nu (skapas/ändras
# av wallpaper-cycle.sh)
/images/backgrounds/.current.jpg
