;; ===================== Variabler =====================
(defpoll battery :interval "3s"
  :initial "{\"pct\":\"?\",\"state\":\"unknown\",\"rate\":\"?\",\"profile\":\"balanced\",\"t_saver\":\"-\",\"t_balanced\":\"-\",\"t_performance\":\"-\"}"
  "~/.config/eww/scripts/battery.sh")
(defpoll volume_info :interval "2s"
  :initial "{\"volume\":0,\"muted\":false,\"sink\":\"...\"}"
  "~/.config/eww/scripts/volume.sh")
(defpoll wifi_status :interval "4s"
  :initial "{\"enabled\":true,\"ssid\":\"\"}"
  "~/.config/eww/scripts/wifi-status.sh")
(defpoll wifi_list :interval "6s" :initial "[]" "~/.config/eww/scripts/wifi-list.sh")
(defpoll audio_sinks :interval "3s" :initial "[]" "~/.config/eww/scripts/audio-sinks.sh")
(defpoll vpn_status :interval "4s"
  :initial "{\"active\":false,\"name\":\"\"}"
  "~/.config/eww/scripts/vpn-status.sh")

;; Optimistiska variabler - sätts direkt vid klick (ingen väntan på nästa poll),
;; och hålls i synk av respektive skript varje tick ifall något ändras på annat håll.
(defvar selected_profile "balanced")
(defvar selected_muted false)
(defvar selected_volume 50)
(defvar selected_wifi_enabled true)

;; Wifi-anslutningsdialogen
(defvar wifi_connect_status "connecting")
(defvar wifi_connect_error_msg "")
(defvar wifi_connect_pw "")
(defvar wifi_connect_ssid "")

;; Systemmeny (minne/temp/nät + snabbåtgärder) - CPU/GPU visas direkt i
;; waybar istället, se vault/04-tema/design.md
(defpoll system_stats :interval "5s"
  :initial "{\"mem\":\"0\",\"temp\":\"0\",\"net\":\"?\"}"
  "~/.config/eww/scripts/system-stats.sh")
(defvar dnd_active false)

;; Inställningspanelen (settings-menu). Samma optimistiska mönster som
;; selected_* ovan: klicket sätter s_*-variabeln direkt (brickan byter läge
;; omedelbart) och kör åtgärden i bakgrunden. settings-status.sh håller
;; variablerna i synk varje tick ifall något ändrats på annat håll.
(defvar s_brightness 50)
(defvar s_nightlight false)
(defvar s_keep_awake false)
(defvar s_mic_muted false)
(defvar s_dnd false)
(defvar s_bt_on false)
(defvar s_bt_service false)
(defvar s_profile "balanced")
;; Effektgalleriet (effects-menu) - en fx_<id> per skärmeffekt, se
;; hypr/scripts/effects.sh. Sätts optimistiskt vid klick, synkas av "sync".
(defvar fx_grade false)
(defvar fx_evening false)
(defvar fx_groundfog false)
(defvar fx_grain false)
(defvar fx_frost false)
(defvar fx_rain false)
(defvar fx_rain_anim false)
(defvar fx_driftfog false)
(defvar fx_leaves false)
(defvar fx_fireflies false)
(defvar fx_snow false)
(defvar fx_any false)
(defvar fx_animated false)
(defpoll fx_tick :interval "5s" :initial "" "~/.config/hypr/scripts/effects.sh sync")
(defpoll settings_tick :interval "3s" :initial "" "~/.config/eww/scripts/settings-status.sh")

;; ===================== Batteri-meny =====================

(defwidget battery-content []
  (box :class "menu-card" :orientation "vertical" :space-evenly false
    (label :class "menu-header" :halign "start"
           :text "${battery.pct}  ·  ${battery.state}  ·  ${battery.rate} W")
    (box :class "menu-sep")
    (button :class "menu-item ${selected_profile == "power-saver" ? "active" : ""}"
            :onclick "powerprofilesctl set power-saver; eww update selected_profile=power-saver"
      (box :orientation "horizontal" :space-evenly false
        (label :class "menu-item-label" :halign "start" :hexpand true :text "Strömsparläge")
        (label :class "menu-item-time" :text "${battery.t_saver}")))
    (button :class "menu-item ${selected_profile == "balanced" ? "active" : ""}"
            :onclick "powerprofilesctl set balanced; eww update selected_profile=balanced"
      (box :orientation "horizontal" :space-evenly false
        (label :class "menu-item-label" :halign "start" :hexpand true :text "Balanserat")
        (label :class "menu-item-time" :text "${battery.t_balanced}")))
    (button :class "menu-item ${selected_profile == "performance" ? "active" : ""}"
            :onclick "powerprofilesctl set performance; eww update selected_profile=performance"
      (box :orientation "horizontal" :space-evenly false
        (label :class "menu-item-label" :halign "start" :hexpand true :text "Prestanda")
        (label :class "menu-item-time" :text "${battery.t_performance}")))
    (box :class "menu-sep")
    (button :class "menu-item"
            :onclick "eww close battery-menu; XDG_CURRENT_DESKTOP=GNOME gnome-control-center power &"
      (label :class "menu-item-label" :halign "start" :text "Energiinställningar"))))

(defwindow battery-menu
  :monitor 0
  :namespace "eww-dropdown"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close battery-menu"
    (box :class "backdrop" :halign "end" :valign "start"
      (eventbox :onclick "true"
        (box :class "align-battery"
          (battery-content))))))

;; ===================== Volym-meny =====================

(defwidget volume-content []
  (box :class "menu-card" :orientation "vertical" :space-evenly false
    (label :class "menu-header" :halign "start" :text "Ljud")
    (box :class "menu-sep")
    (box :orientation "horizontal" :space-evenly false :class "menu-item"
      (button :class "icon-btn"
              :onclick "pactl set-sink-mute @DEFAULT_SINK@ toggle; eww update selected_muted=${selected_muted ? "false" : "true"}"
        (label :text "${selected_muted ? "󰝟" : "󰕾"}"))
      (scale :class "volume-scale" :hexpand true
             :min 0 :max 150 :value "${selected_volume}"
             :onchange "pactl set-sink-volume @DEFAULT_SINK@ {}%; eww update selected_volume={}")
      (label :class "menu-item-time" :text "${selected_volume}%"))
    (box :class "menu-sep")
    ;; Val av ljudutgang - PipeWire flyttar med pagaende ljud till den nya enheten
    (label :class "menu-subheader" :halign "start" :text "Utgång")
    (for sink in audio_sinks
      (button :class "menu-item ${sink.default ? "active" : ""}"
              :onclick "pactl set-default-sink '${sink.name}'"
        (box :orientation "horizontal" :space-evenly false
          (label :class "menu-item-label" :halign "start" :hexpand true :text "${sink.desc}" :limit-width 28)
          (label :class "menu-item-icon" :text "${sink.default ? "󰄬" : ""}"))))
    (box :class "menu-sep")
    (button :class "menu-item"
            :onclick "eww close volume-menu; pavucontrol &"
      (label :class "menu-item-label" :halign "start" :text "Ljudinställningar"))))

(defwindow volume-menu
  :monitor 0
  :namespace "eww-dropdown"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close volume-menu"
    (box :class "backdrop" :halign "end" :valign "start"
      (eventbox :onclick "true"
        (box :class "align-volume"
          (volume-content))))))

;; ===================== Wifi-meny =====================

(defwidget wifi-content []
  (box :class "menu-card" :orientation "vertical" :space-evenly false
    (box :orientation "horizontal" :class "menu-header-row" :space-evenly false
      (label :class "menu-header" :halign "start" :hexpand true
             :text "${selected_wifi_enabled ? "Wi-Fi på" : "Wi-Fi av"}")
      (button :class "icon-btn"
              :onclick "nmcli radio wifi ${selected_wifi_enabled ? "off" : "on"}; eww update selected_wifi_enabled=${selected_wifi_enabled ? "false" : "true"}"
        (label :text "${selected_wifi_enabled ? "󰤨" : "󰤭"}")))
    ;; VPN-rad - bara status (anslutning sköts av t.ex. eduVPN-klienten)
    (box :orientation "horizontal" :space-evenly false
         :class "menu-item vpn-row ${vpn_status.active ? "active" : ""}"
      (label :class "menu-item-icon" :text "${vpn_status.active ? "󰦝" : "󰦞"}")
      (label :class "menu-item-label" :halign "start" :hexpand true
             :text "${vpn_status.active ? "VPN: ${vpn_status.name}" : "VPN av"}" :limit-width 22))
    (box :class "menu-sep")
    (for network in wifi_list
      ;; Signal som staplar, procent i tooltip. Det anslutna natet ligger
      ;; overst med bock och "Ansluten" - klick pa det gor ingenting.
      (button :class "menu-item wifi-row ${network.active ? "active" : ""}"
              :tooltip "${network.ssid} - signal ${network.signal}%"
              :onclick "${network.active ? "true" : "~/.config/eww/scripts/wifi-open-connect.sh '${network.ssid_q}'"}"
        (box :orientation "horizontal" :space-evenly false
          (label :class "wifi-signal" :text "${network.icon}")
          (box :orientation "vertical" :space-evenly false :hexpand true :valign "center"
            (label :class "menu-item-label" :halign "start" :text "${network.ssid}" :limit-width 24)
            (label :class "wifi-sub" :halign "start" :visible {network.active} :text "Ansluten"))
          (label :class "menu-item-icon" :text "${network.active ? "󰄬" : (network.secured ? "󰌾" : "")}"))))
    (box :class "menu-sep")
    (button :class "menu-item"
            :onclick "eww close wifi-menu; XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi &"
      (label :class "menu-item-label" :halign "start" :text "Nätverksinställningar"))))

(defwindow wifi-menu
  :monitor 0
  :namespace "eww-dropdown"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close wifi-menu"
    (box :class "backdrop" :halign "end" :valign "start"
      (eventbox :onclick "true"
        (box :class "align-wifi"
          (wifi-content))))))

;; ===================== Wifi anslut-dialog =====================

(defwidget wifi-connect-content [ssid]
  (box :class "menu-card" :orientation "vertical" :space-evenly false
    (label :class "menu-header" :halign "start" :text "Anslut till ${ssid}")
    (box :class "menu-sep")

    (label :class "wifi-status-label"
           :visible {wifi_connect_status == "connecting"}
           :text "Ansluter...")

    (label :class "wifi-status-label wifi-status-success"
           :visible {wifi_connect_status == "success"}
           :text "✔ Ansluten!")

    (box :orientation "vertical" :space-evenly false
         :visible {wifi_connect_status == "need_password" || wifi_connect_status == "error"}
      (label :class "wifi-status-label wifi-status-error"
             :halign "start"
             :visible {wifi_connect_status == "error"}
             :text "✘ ${wifi_connect_error_msg}")
      (input :class "wifi-password-input"
             :password true
             :value wifi_connect_pw
             :onchange "eww update wifi_connect_pw={}"
             :onaccept "~/.config/eww/scripts/wifi-submit-password.sh")
      (button :class "menu-item wifi-connect-btn"
              :onclick "~/.config/eww/scripts/wifi-submit-password.sh"
        (label :halign "center" :text "Anslut")))))

;; ===================== Systemmeny =====================

(defwidget system-content []
  (box :class "menu-card" :orientation "vertical" :space-evenly false
    (label :class "menu-header" :halign "start" :text "System")
    (box :class "menu-sep")
    (box :orientation "horizontal" :space-evenly false :class "menu-item"
      (label :class "menu-item-label" :halign "start" :hexpand true :text "Minne")
      (label :class "menu-item-time" :text "${system_stats.mem}%"))
    (box :orientation "horizontal" :space-evenly false :class "menu-item"
      (label :class "menu-item-label" :halign "start" :hexpand true :text "Temperatur")
      (label :class "menu-item-time" :text "${system_stats.temp}°C"))
    (button :class "menu-item"
            :onclick "eww close system-menu; eww open wifi-menu"
      (box :orientation "horizontal" :space-evenly false
        (label :class "menu-item-label" :halign "start" :hexpand true :text "Nätverk")
        (label :class "menu-item-time" :text "${system_stats.net}")))
    (box :class "menu-sep")
    ;; GNOME quick-settings-stil: fyrkantiga toggle-brickor sida vid sida
    ;; istället för radlista - i vår palett, inte GNOME:s blå/grå.
    (box :orientation "horizontal" :space-evenly true :class "tile-grid"
      (button :class "tile ${selected_wifi_enabled ? "active" : ""}"
              :onclick "nmcli radio wifi ${selected_wifi_enabled ? "off" : "on"}; eww update selected_wifi_enabled=${selected_wifi_enabled ? "false" : "true"}"
        (box :orientation "vertical" :space-evenly false :halign "center"
          (label :class "tile-icon" :text "")
          (label :class "tile-label" :text "Wi-Fi")))
      (button :class "tile ${dnd_active ? "active" : ""}"
              :onclick "swaync-client -d > /dev/null; eww update dnd_active=${dnd_active ? "false" : "true"}"
        (box :orientation "vertical" :space-evenly false :halign "center"
          (label :class "tile-icon" :text "")
          (label :class "tile-label" :text "Stör ej"))))
    (box :class "menu-sep")
    (button :class "menu-item"
            :onclick "eww close system-menu; pavucontrol &"
      (label :class "menu-item-label" :halign "start" :text "Ljudinställningar"))
    (button :class "menu-item"
            :onclick "eww close system-menu; eww open settings-menu"
      (label :class "menu-item-label" :halign "start" :text "Inställningar"))
    (button :class "menu-item"
            :onclick "eww close system-menu; hyprlock &"
      (label :class "menu-item-label" :halign "start" :text "Lås skärm"))
    (button :class "menu-item"
            :onclick "eww close system-menu; systemctl suspend"
      (label :class "menu-item-label" :halign "start" :text "Vila"))
    (box :class "menu-sep")
    (button :class "menu-item danger"
            :onclick "eww close system-menu; systemctl reboot"
      (label :class "menu-item-label" :halign "start" :text "Starta om"))
    (button :class "menu-item danger"
            :onclick "eww close system-menu; systemctl poweroff"
      (label :class "menu-item-label" :halign "start" :text "Stäng av"))))

(defwindow system-menu
  :monitor 0
  :namespace "eww-dropdown"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close system-menu"
    (box :class "backdrop" :halign "end" :valign "start"
      (eventbox :onclick "true"
        (box :class "align-system"
          (system-content))))))

(defwindow wifi-connect [ssid]
  :monitor 0
  :namespace "eww-dropdown"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable true
  (eventbox :onclick "eww update wifi_connect_pw=''; eww close wifi-connect"
    (box :class "backdrop" :halign "center" :valign "center"
      (eventbox :onclick "true"
        (box :class "align-wifi-connect"
          (wifi-connect-content :ssid ssid))))))

;; ===================== Inställningspanel =====================

;; Fyrkantig av/på-bricka (samma stil som i systemmenyn)
(defwidget stile [active icon text onclick]
  (button :class "tile ${active ? "active" : ""}" :onclick onclick
    (box :orientation "vertical" :space-evenly false :halign "center"
      (label :class "tile-icon" :text icon)
      (label :class "tile-label" :text text))))

(defwidget settings-content []
  (box :class "menu-card" :orientation "vertical" :space-evenly false
    (label :class "menu-header" :halign "start" :text "Inställningar")
    ;; osynlig - finns bara for att eww ska kora pollen medan panelen ar oppen
    (label :visible false :text settings_tick)
    (box :class "menu-sep")
    ;; Ljusstyrka - min 5 % så att skärmen aldrig blir helt svart
    (box :orientation "horizontal" :space-evenly false :class "menu-item"
      (label :class "slider-icon" :text "󰃠")
      (scale :class "volume-scale" :hexpand true
             :min 5 :max 101 :value s_brightness
             :onchange "brightnessctl -q set {}%; eww update s_brightness={}")
      (label :class "menu-item-time" :text "${s_brightness}%"))
    (box :class "menu-sep")
    (box :orientation "horizontal" :space-evenly true :class "tile-grid"
      (stile :active s_nightlight :icon "󰖔" :text "Nattljus"
             :onclick "eww update s_nightlight=${s_nightlight ? "false" : "true"}; ~/.config/eww/scripts/settings-toggle.sh nightlight &")
      (stile :active s_keep_awake :icon "󰅶" :text "Håll vaken"
             :onclick "eww update s_keep_awake=${s_keep_awake ? "false" : "true"}; ~/.config/eww/scripts/settings-toggle.sh keep-awake &")
      (stile :active s_mic_muted :icon "${s_mic_muted ? "󰍭" : "󰍬"}" :text "Mikrofon av"
             :onclick "eww update s_mic_muted=${s_mic_muted ? "false" : "true"}; ~/.config/eww/scripts/settings-toggle.sh mic &"))
    (box :orientation "horizontal" :space-evenly true :class "tile-grid"
      (stile :active s_dnd :icon "󰂛" :text "Stör ej"
             :onclick "eww update s_dnd=${s_dnd ? "false" : "true"}; ~/.config/eww/scripts/settings-toggle.sh dnd &")
      (stile :active s_bt_on :icon "${s_bt_on ? "󰂯" : "󰂲"}"
             :text "${s_bt_service ? "Bluetooth" : "Bluetooth (av)"}"
             :onclick "~/.config/eww/scripts/settings-toggle.sh bluetooth &")
      (stile :active fx_any :icon "󰸌" :text "Effekter"
             :onclick "eww close settings-menu; eww open effects-menu"))
    (box :class "menu-sep")
    (label :class "menu-subheader" :halign "start" :text "Energiprofil")
    (box :orientation "horizontal" :space-evenly true :class "segmented"
      (button :class "seg ${s_profile == "power-saver" ? "active" : ""}"
              :onclick "eww update s_profile=power-saver selected_profile=power-saver; ~/.config/eww/scripts/settings-toggle.sh profile power-saver &"
        (label :text "Spara"))
      (button :class "seg ${s_profile == "balanced" ? "active" : ""}"
              :onclick "eww update s_profile=balanced selected_profile=balanced; ~/.config/eww/scripts/settings-toggle.sh profile balanced &"
        (label :text "Balans"))
      (button :class "seg ${s_profile == "performance" ? "active" : ""}"
              :onclick "eww update s_profile=performance selected_profile=performance; ~/.config/eww/scripts/settings-toggle.sh profile performance &"
        (label :text "Prestanda")))
    (box :class "menu-sep")
    (button :class "menu-item"
            :onclick "~/.config/eww/scripts/settings-toggle.sh wallpaper"
      (box :orientation "horizontal" :space-evenly false
        (label :class "menu-item-label" :halign "start" :hexpand true :text "Byt bakgrund nu")
        (label :class "menu-item-icon" :text "󰸉")))
    (button :class "menu-item"
            :onclick "eww close settings-menu; XDG_CURRENT_DESKTOP=GNOME gnome-control-center &"
      (box :orientation "horizontal" :space-evenly false
        (label :class "menu-item-label" :halign "start" :hexpand true :text "Fler inställningar")
        (label :class "menu-item-icon" :text "󰒓")))))

(defwindow settings-menu
  :monitor 0
  :namespace "eww-dropdown"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close settings-menu"
    (box :class "backdrop" :halign "end" :valign "start"
      (eventbox :onclick "true"
        (box :class "align-system"
          (settings-content))))))

;; ===================== Effektgalleri =====================

;; Ett kort per effekt: förhandsbild (renderad av
;; hypr/scripts/render-effect-previews.py), namn, kostnad och beskrivning.
(defwidget fxcard [id name desc active animated]
  (button :class "fx-card ${active ? "active" : ""}"
          :onclick "eww update fx_${id}=${active ? "false" : "true"}; ~/.config/hypr/scripts/effects.sh toggle ${id} &"
    (box :orientation "vertical" :space-evenly false
      (overlay
        (image :path "/home/jakob/dotfiles/images/effect-previews/${id}.png"
               :image-width 192 :image-height 128)
        (label :class "fx-check" :halign "end" :valign "start" :visible active :text "󰄬"))
      (box :orientation "horizontal" :space-evenly false
        (label :class "fx-name" :halign "start" :hexpand true :text name)
        (label :class "fx-badge ${animated ? "cost" : "free"}" :text "${animated ? "~2 W" : "Gratis"}"))
      (label :class "fx-desc" :halign "start" :xalign 0 :wrap true :text desc))))

(defwidget effects-content []
  (box :class "menu-card fx-panel" :orientation "vertical" :space-evenly false
    ;; osynlig - finns bara för att pollen ska köras medan galleriet är öppet
    (label :visible false :text fx_tick)
    (box :orientation "horizontal" :space-evenly false
      (box :orientation "vertical" :space-evenly false :hexpand true
        (label :class "menu-header fx-header" :halign "start" :text "Effekter")
        (label :class "fx-sub" :halign "start"
               :text "Klicka för att slå på/av. Effekterna kan kombineras."))
      (button :class "icon-btn" :valign "start" :onclick "eww close effects-menu"
        (label :text "󰅖")))
    (box :class "menu-sep")
    (box :orientation "horizontal" :space-evenly false :spacing 18
      (box :orientation "vertical" :space-evenly false
        (label :class "fx-section" :halign "start" :text "Stillastående · gratis")
        (box :orientation "horizontal" :space-evenly true
          (fxcard :id "grade" :name "Höstljus" :active fx_grade :animated false
                  :desc "Varma skuggor, mossgröna mellantoner, mjuk vinjett.")
          (fxcard :id "evening" :name "Kvällsläge" :active fx_evening :animated false
                  :desc "Mörkare och kallare toner för kvällen.")
          (fxcard :id "groundfog" :name "Markdimma" :active fx_groundfog :animated false
                  :desc "Dimma som ligger tät längs nederkanten."))
        (box :orientation "horizontal" :space-evenly true
          (fxcard :id "grain" :name "Filmkorn" :active fx_grain :animated false
                  :desc "Fint, stilla korn som på analog film.")
          (fxcard :id "frost" :name "Frost" :active fx_frost :animated false
                  :desc "Iskristaller som växer in från hörnen.")
          (fxcard :id "rain" :name "Regn" :active fx_rain :animated false
                  :desc "Droppar och dis på rutan, stilla. Super+Shift+W.")))
      (box :orientation "vertical" :space-evenly false
        (label :class "fx-section" :halign "start" :text "Rörliga · ritar om skärmen hela tiden")
        (box :orientation "horizontal" :space-evenly true
          (fxcard :id "rain_anim" :name "Regn, rinnande" :active fx_rain_anim :animated true
                  :desc "Droppar som rinner ner och lämnar spår. Super+Alt+W.")
          (fxcard :id "driftfog" :name "Drivande dimma" :active fx_driftfog :animated true
                  :desc "Dimma som långsamt driver förbi.")
          (fxcard :id "leaves" :name "Fallande löv" :active fx_leaves :animated true
                  :desc "Höstlöv i guld och rost som singlar ner."))
        (box :orientation "horizontal" :space-evenly true
          (fxcard :id "fireflies" :name "Eldflugor" :active fx_fireflies :animated true
                  :desc "Små guldljus som glöder och driver.")
          (fxcard :id "snow" :name "Snö" :active fx_snow :animated true
                  :desc "Stilla snöfall i tre djup.")
          ;; "Inga effekter" - stänger av allt
          (button :class "fx-card ${fx_any ? "" : "active"}"
                  :onclick "~/.config/hypr/scripts/effects.sh off &"
            (box :orientation "vertical" :space-evenly false
              (overlay
                (image :path "/home/jakob/dotfiles/images/effect-previews/none.png"
                       :image-width 192 :image-height 128)
                (label :class "fx-check" :halign "end" :valign "start" :visible {!fx_any} :text "󰄬"))
              (box :orientation "horizontal" :space-evenly false
                (label :class "fx-name" :halign "start" :hexpand true :text "Inga effekter"))
              (label :class "fx-desc" :halign "start" :xalign 0 :wrap true
                     :text "Stäng av allt - skärmen som vanligt."))))))
    (box :class "menu-sep")
    (label :class "fx-status ${fx_animated ? "cost" : ""}" :halign "start"
           :text "${fx_animated ? "En rörlig effekt är på: hela skärmen ritas om 60 ggr/s, ca 2 W extra." : "Inga rörliga effekter på: ingen extra energiförbrukning."}")))

(defwindow effects-menu
  :monitor 0
  :namespace "eww-dropdown"
  :geometry (geometry :x "0" :y "0" :width "100%" :height "100%" :anchor "top left")
  :stacking "overlay"
  :focusable false
  (eventbox :onclick "eww close effects-menu"
    (box :class "backdrop" :halign "center" :valign "center"
      (eventbox :onclick "true"
        (effects-content)))))
